{
  "description": "atlias: links the session to the sub-harness at start (progress note, shared memory, graphify god nodes, companion skills), answers codebase questions from the graph before the model reads files, guards against repeated identical tool calls and destructive commands, tracks every changed file, says once a turn when a whole file was read that the graph could have answered and names the query that would have done it, runs a syntax and two-pass verification gate before the reply ends, writes a handoff note before compaction and re-injects it after, and hands each session to Dream for memory consolidation at exit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" session-start",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|write_file|replace|edit_file|create_file|Bash|PowerShell|shell|exec|exec_command|run_shell_command|run_terminal_cmd|local_shell|Read|read_file|readfile|read|view|view_file|open_file|cat|get_file_contents",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|shell|exec|exec_command|run_shell_command|run_terminal_cmd|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" post-tool-failure",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" pre-compact",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" post-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" stop",
            "timeout": 45
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" subagent-stop",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/lib/hooks.mjs\" session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
